)","guide":"stat-guide/correspondence-analysis.html","fields":[{"key":"row_var","label":"Row variable (a category, or the row label of a count table)","type":"col","required":true,"help":""},{"key":"col_var","label":"Column variable (one row per case; leave blank for a count table)","type":"col","required":false,"help":""},{"key":"counts","label":"Count columns (for a table that is already cross-tabulated)","type":"cols","required":false,"help":""}],"example":{"file":"stat-guide/examples/caith.csv","spec":{"row_var":"eye","counts":["fair","red","medium","dark","black"]}},"division":"statistics","packages":[],"slow":false},{"id":"stat_km","code":"D1","group":"Survival analysis","name":"Kaplan-Meier estimator and log-rank test","guide":"stat-guide/kaplan-meier.html","fields":[{"key":"time","label":"Follow-up time","type":"col","required":true,"help":""},{"key":"event","label":"Event indicator (1 = event, 0 = censored)","type":"col","required":true,"help":""},{"key":"group","label":"Grouping variable (optional)","type":"col","required":false,"help":""},{"key":"test","label":"Test across groups","type":"select","options":[["logrank","Log-rank"],["gehan","Gehan-Breslow (Wilcoxon)"],["peto","Peto-Peto"]],"default":"logrank","help":""},{"key":"ci_type","label":"Confidence interval","type":"select","options":[["loglog","Log-log"],["log","Log"],["plain","Plain"]],"default":"loglog","help":""},{"key":"alpha","label":"Significance level","type":"num","default":0.05,"help":""}],"example":{"file":"stat-guide/examples/veteran.csv","spec":{"time":"time","event":"status","group":"trt"}},"division":"statistics","packages":[],"slow":false},{"id":"stat_cox","code":"D2","group":"Survival analysis","name":"Cox proportional hazards model","guide":"stat-guide/cox-ph.html","fields":[{"key":"time","label":"Follow-up time","type":"col","required":true,"help":""},{"key":"event","label":"Event indicator (1 = event, 0 = censored)","type":"col","required":true,"help":""},{"key":"covariates","lab